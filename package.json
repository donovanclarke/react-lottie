{
  "name": "react-lottie-wrapper",
  "version": "2.1.0",
  "description": "lottie animation view for React",
  "packageManager": "npm@10.9.3",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/donovanclarke/react-lottie.git"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "lottie",
    "animation",
    "react",
    "react-lottie"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "start": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "devDependencies": {
    "@babel/cli": "^7.26.4",
    "@babel/core": "^7.26.9",
    "@babel/eslint-parser": "^7.26.8",
    "@babel/plugin-transform-runtime": "^7.26.9",
    "@babel/polyfill": "^7.12.1",
    "@babel/preset-react": "^7.26.3",
    "@babel/preset-typescript": "^7.29.7",
    "@babel/runtime": "^7.26.9",
    "@changesets/cli": "^2.31.0",
    "@chromatic-com/storybook": "^3.2.4",
    "@storybook/addon-essentials": "^8.5.7",
    "@storybook/addon-interactions": "^8.5.7",
    "@storybook/addon-webpack5-compiler-swc": "^2.1.0",
    "@storybook/blocks": "^8.5.7",
    "@storybook/react": "^8.5.7",
    "@storybook/react-webpack5": "^8.5.7",
    "@storybook/test": "^8.5.7",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "babel-jest": "^29.7.0",
    "babel-preset-react-app": "^10.1.0",
    "eslint": "^8.2.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.25.3",
    "eslint-plugin-jsx-a11y": "^6.5.1",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react": "^7.28.0",
    "eslint-plugin-react-hooks": "^4.3.0",
    "eslint-plugin-storybook": "^0.11.3",
    "git-url-parse": "^6.0.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jsdom": "^9.5.0",
    "prettier": "^3.8.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "standard-version": "^4.4.0",
    "storybook": "^8.5.7",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "dependencies": {
    "lottie-web": "^5.12.1"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended",
      "plugin:storybook/recommended"
    ]
  },
  "jest": {
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "<rootDir>/src/**/*.test.tsx"
    ],
    "transform": {
      "^.+\\.[jt]sx?$": "babel-jest"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/src/setupTests.ts"
    ],
    "testEnvironment": "jest-environment-jsdom",
    "moduleNameMapper": {
      "^lottie-web$": "<rootDir>/src/tests/__mocks__/lottie-web.js"
    }
  }
}
