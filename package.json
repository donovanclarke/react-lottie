{
  "name": "react-lottie-wrapper",
  "version": "1.1.8",
  "description": "lottie animation view for React",
  "repository": {
    "type": "git",
    "url": "https://github.com/donovanclarke/react-lottie"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "lottie",
    "animation",
    "react",
    "react-lottie"
  ],
  "license": "MIT",
  "scripts": {
    "release": "git add package.json && git commit -m 'chore: bump version number' && standard-version --first-release && git push --follow-tags origin master && npm publish",
    "prepublish": ". ./.scripts/prepublish.sh",
    "lint": "eslint src",
    "lintfix": "eslint src --fix",
    "testonly": "mocha --require .scripts/mocha_runner src/**/tests/**/*.js",
    "test": "npm run lint && npm run testonly",
    "test-watch": "npm run testonly -- --watch --watch-extensions js",
    "start": "storybook dev -p 6006",
    "publish-storybook": "bash .scripts/publish_storybook.sh",
    "postpublish": "npm run publish-storybook",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^3.2.4",
    "@storybook/addon-essentials": "^8.5.7",
    "@storybook/addon-interactions": "^8.5.7",
    "@storybook/addon-webpack5-compiler-swc": "^2.1.0",
    "@storybook/blocks": "^8.5.7",
    "@storybook/react": "^8.5.7",
    "@storybook/react-webpack5": "^8.5.7",
    "@storybook/test": "^8.5.7",
    "babel-cli": "^6.26.0",
    "babel-core": "^6.26.3",
    "babel-eslint": "^6.1.2",
    "babel-loader": "^6.2.5",
    "babel-plugin-transform-runtime": "^6.15.0",
    "babel-polyfill": "^6.26.0",
    "babel-preset-react-app": "^0.2.1",
    "chai": "^3.5.0",
    "eslint-plugin-storybook": "^0.11.3",
    "git-url-parse": "^6.0.1",
    "jsdom": "^9.5.0",
    "mocha": "^5.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sinon": "^1.17.6",
    "standard-version": "^4.4.0",
    "storybook": "^8.5.7"
  },
  "peerDependencies": {
    "react": "^0.14.7 || >=^15.0.0"
  },
  "dependencies": {
    "lottie-web": "^5.1.3",
    "prop-types": "^15.8.1"
  },
  "main": "dist/index.js",
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended",
      "plugin:storybook/recommended"
    ]
  }
}
